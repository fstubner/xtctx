{
  "name": "xtctx-cloud",
  "version": "0.3.0",
  "description": "Unified Node + PostgreSQL cloud server and worker for xtctx",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/server.mjs serve",
    "worker": "node dist/worker.mjs",
    "migrate": "node dist/server.mjs migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:semantic": "vitest run test/unit/search-and-worker.test.ts",
    "test:integration": "vitest run test/integration",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.6",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
