---
import { site } from '../data/site';
const { branding, hero } = site;
---
<nav>
  <a class="mark" href="/" aria-label={branding.wordmarkAlt}>
    {branding.wordmark
      ? <img src={branding.wordmark} alt={branding.wordmarkAlt} width="160" height="32" />
      : <span class="wordmark-text">xt<span class="accent">ctx</span></span>
    }
  </a>
  <div class="nlinks">
    <a href="#how">How it works</a>
    <a href="#surfaces">Features</a>
    <a href="#install">Setup</a>
    <a href="#faq">FAQs</a>
    <a href={hero.sourceUrl}>GitHub</a>
  </div>
</nav>
