---
import { site } from '../data/site';
import IdeMock from './IdeMock.astro';
const { surfaces, copy } = site;

const showcase = surfaces[0];
const subFeatures = surfaces.slice(1);
---
<section id="surfaces">
  <div class="w">
    <div class="section-kicker">Features</div>
    <h2>{copy.surfaces.heading}</h2>
    <p class="lead" set:html={copy.surfaces.leadHtml} />

    <div class="surfaces">
      <!-- Showcase Card (Full-width IDE Mockup Showcase) -->
      <div class="showcase-card">
        <div class="showcase-header">
          <h3>{showcase.title}</h3>
          <p set:html={showcase.body} />
        </div>
        <div class="showcase-visual">
          <IdeMock />
        </div>
      </div>

      <!-- Features Grid (Symmetric 3-column capabilities) -->
      <div class="features-grid">
        {subFeatures.map((f, i) => {
          return (
            <div class="feature-card">
              <div class="feature-header">
                <div class="feature-icon">
                  {i === 0 && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px">
                      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                    </svg>
                  )}
                  {i === 1 && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                      <path d="m9 11 2 2 4-4"/>
                    </svg>
                  )}
                  {i === 2 && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px">
                      <circle cx="11" cy="11" r="8"/>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                      <polyline points="11 6 11 12 14 14"/>
                    </svg>
                  )}
                </div>
                <h3>{f.title}</h3>
              </div>
              <p set:html={f.body} />
              {f.codeHtml && (
                <div class="codeblock-wrapper has-copy">
                  <pre class="codeblock-mini"><code set:html={f.codeHtml} /></pre>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

