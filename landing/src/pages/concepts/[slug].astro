---
import IdeMock from '../../components/IdeMock.astro';
import TerminalMock from '../../components/TerminalMock.astro';
import {
  conceptFeatures,
  conceptNav,
  concepts,
  setupLines,
  statusLines,
  type Concept,
} from '../../data/concepts';

export function getStaticPaths() {
  return concepts.map((concept) => ({
    params: { slug: concept.slug },
    props: { concept },
  }));
}

const { concept } = Astro.props as { concept: Concept };
const currentIndex = concepts.findIndex((item) => item.slug === concept.slug);
const setupOutputHtml = [
  '<span class="prompt">$</span> npx -y xtctx setup',
  ...setupLines.map((line) => {
    const [status, ...rest] = line.split(' ');
    return `<span class="ok">${status}</span> ${rest.join(' ')}`;
  }),
].join('\n');

const blueprintNodes = [
  { label: 'setup', title: 'Detect tools', body: 'MCP config, instructions, hooks' },
  { label: 'select', title: 'Choose skills', body: 'Keep the project skill set explicit' },
  { label: 'handoff', title: 'Call MCP', body: 'recent, detail, search, status' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{concept.name} - xtctx landing concept</title>
    <style is:global>
      :root{
        --bg:#07111f;
        --bg-2:#0a1627;
        --panel:#0d1b2e;
        --panel-2:#10223a;
        --ink:#f7f0e4;
        --text:#dbe7f5;
        --muted:#9faec4;
        --quiet:#71829b;
        --line:#26384f;
        --line-2:#1a2b42;
        --accent:#f0b86b;
        --accent-2:#ffd08a;
        --ok:#9bd7b2;
        --max:1120px;
      }
      *{box-sizing:border-box}
      html{scroll-behavior:smooth;overflow-x:hidden}
      body{
        margin:0;
        min-width:0;
        overflow-x:hidden;
        padding-top:64px;
        color:var(--ink);
        background:
          linear-gradient(rgba(255,255,255,.034) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,.034) 1px, transparent 1px),
          radial-gradient(circle at 18% 4%, rgba(240,184,107,.10), transparent 32rem),
          var(--bg);
        background-size:32px 32px,32px 32px,auto,auto;
        font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
        line-height:1.55;
        -webkit-font-smoothing:antialiased;
      }
      a{color:inherit}
      .wrap{width:min(var(--max),calc(100vw - 40px));margin:0 auto}
      .topbar{
        position:fixed;
        top:0;
        left:0;
        right:0;
        z-index:30;
        border-bottom:1px solid var(--line);
        background:rgba(7,17,31,.9);
        backdrop-filter:blur(14px);
      }
      .boxed-product .topbar{
        width:min(var(--max),calc(100vw - 40px));
        margin:0 auto;
        left:50%;
        right:auto;
        transform:translateX(-50%);
        border-left:1px solid var(--line);
        border-right:1px solid var(--line);
      }
      .nav{
        min-height:64px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:24px;
      }
      .brand{
        color:var(--ink);
        font-size:22px;
        font-weight:850;
        letter-spacing:0;
        text-decoration:none;
      }
      .brand span{color:var(--accent)}
      .navlinks{
        display:flex;
        align-items:center;
        gap:22px;
      }
      .navlinks a{
        color:var(--text);
        text-decoration:none;
        font-size:14px;
        font-weight:650;
      }
      .navlinks a:hover{color:var(--ink)}
      .page-frame{
        width:min(var(--max),calc(100vw - 40px));
        margin:36px auto 70px;
      }
      .boxed-product .page-frame{
        border:1px solid var(--line);
        background:
          linear-gradient(rgba(255,255,255,.026) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,.026) 1px, transparent 1px),
          rgba(13,27,46,.36);
        background-size:32px 32px,32px 32px,auto;
      }
      .hero-shell{
        display:grid;
        grid-template-columns:minmax(0,1fr) minmax(420px,.9fr);
        gap:56px;
        align-items:center;
        min-height:680px;
        padding:72px 0;
      }
      .boxed-product .hero-shell{
        grid-template-columns:minmax(0,.94fr) minmax(390px,.86fr);
        gap:50px;
        min-height:520px;
        padding:48px 48px 44px;
        border-bottom:1px solid var(--line);
      }
      .cli-first .hero-shell{
        display:block;
        min-height:0;
        max-width:900px;
        margin:0 auto;
        padding:78px 0 42px;
        text-align:center;
      }
      .docs-hybrid .hero-shell{
        display:block;
        min-height:0;
        max-width:860px;
        padding:72px 0 36px;
      }
      .two-column-proof .hero-shell{
        min-height:560px;
        grid-template-columns:minmax(0,.9fr) minmax(420px,1fr);
      }
      .kicker,.section-label{
        margin:0 0 16px;
        color:var(--accent);
        font-family:ui-monospace,"SF Mono",Consolas,monospace;
        font-size:12px;
        letter-spacing:.14em;
        text-transform:uppercase;
      }
      h1,h2,h3,p{margin-top:0}
      h1{
        max-width:12ch;
        margin:0 0 22px;
        font-size:clamp(46px,6vw,80px);
        line-height:.98;
        letter-spacing:0;
      }
      .boxed-product h1{
        max-width:14ch;
        font-size:clamp(40px,4.4vw,60px);
        line-height:1.01;
      }
      .cli-first h1,.docs-hybrid h1{max-width:none}
      .hero-copy p{
        max-width:660px;
        margin-bottom:24px;
        color:var(--text);
        font-size:19px;
      }
      .boxed-product .hero-copy p{
        max-width:640px;
        margin-bottom:20px;
        font-size:18px;
      }
      .cli-first .hero-copy p{
        max-width:720px;
        margin-left:auto;
        margin-right:auto;
      }
      .proof-list{
        display:flex;
        flex-wrap:wrap;
        gap:12px 20px;
        margin:0 0 26px;
        padding:0;
        color:var(--text);
        font-family:ui-monospace,"SF Mono",Consolas,monospace;
        font-size:12px;
        letter-spacing:.04em;
        list-style:none;
        text-transform:uppercase;
      }
      .boxed-product .proof-list{
        margin-bottom:18px;
      }
      .proof-list li::before{
        content:"✓";
        margin-right:8px;
        color:var(--accent);
      }
      .actions{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
      .cli-first .actions{justify-content:center}
      .button{
        min-height:44px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        border:1px solid rgba(240,184,107,.5);
        border-radius:7px;
        padding:10px 15px;
        color:var(--ink);
        background:rgba(240,184,107,.08);
        text-decoration:none;
        font-weight:750;
        font-size:14px;
      }
      .button.secondary{
        border-color:var(--line);
        background:rgba(255,255,255,.02);
        color:var(--text);
      }
      .command-pill{
        display:flex;
        gap:12px;
        align-items:center;
        max-width:520px;
        margin:28px 0 20px;
        border:1px solid rgba(240,184,107,.5);
        border-radius:8px;
        padding:15px 18px;
        color:var(--ink);
        background:#07101d;
        font-family:ui-monospace,"SF Mono",Consolas,monospace;
        overflow-wrap:anywhere;
      }
      .boxed-product .command-pill{
        max-width:480px;
        margin-top:20px;
      }
      .cli-first .command-pill{
        margin-left:auto;
        margin-right:auto;
        justify-content:center;
      }
      .prompt{color:var(--accent);font-weight:800}
      .terminal-card,.diagram-card,.mini-terminal,.proof-card{
        min-width:0;
        border:1px solid var(--line);
        border-radius:10px;
        background:rgba(13,27,46,.94);
        box-shadow:0 22px 70px rgba(0,0,0,.28);
        overflow:hidden;
      }
      .setup-terminal{
        min-width:0;
        border:1px solid var(--line);
        border-radius:10px;
        background:#080f1a;
        box-shadow:0 22px 70px rgba(0,0,0,.28);
        overflow:hidden;
      }
      .setup-terminal-head{
        min-height:46px;
        display:grid;
        grid-template-columns:1fr auto 1fr;
        align-items:center;
        gap:14px;
        border-bottom:1px solid var(--line);
        padding:0 14px;
        color:var(--text);
        font-family:ui-monospace,"SF Mono",Consolas,monospace;
        font-size:12px;
        letter-spacing:.08em;
        text-transform:uppercase;
      }
      .terminal-dots{
        display:flex;
        gap:8px;
        align-items:center;
      }
      .terminal-dots span{
        width:11px;
        height:11px;
        border-radius:50%;
        background:#ff6464;
      }
      .terminal-dots span:nth-child(2){background:#f2c84b}
      .terminal-dots span:nth-child(3){background:#43d765}
      .setup-terminal-body{
        display:grid;
        gap:8px;
        padding:20px 22px;
        color:var(--text);
        font-family:ui-monospace,"SF Mono",Consolas,monospace;
        font-size:13px;
        line-height:1.55;
      }
      .term-line,
      .term-note,
      .term-choice,
      .term-success{
        margin:0;
      }
      .term-command{
        margin:0 0 8px;
        color:var(--ink);
      }
      .term-note{
        color:var(--quiet);
      }
      .term-question{
        margin:8px 0 0;
        color:var(--accent);
        font-weight:800;
      }
      .term-choice{
        display:grid;
        grid-template-columns:44px minmax(0,1fr) auto;
        gap:10px;
        align-items:baseline;
        color:var(--text);
      }
      .term-choice span:first-child{
        color:var(--accent);
      }
      .term-choice em{
        color:var(--quiet);
        font-style:normal;
        font-size:12px;
      }
      .term-rule{
        height:1px;
        margin:8px 0;
        background:var(--line);
      }
      .term-success{
        color:var(--text);
      }
      .term-success .ok{
        margin-right:8px;
        font-weight:800;
      }
      .term-done{
        margin:8px 0 0;
        color:var(--ok);
        font-weight:800;
      }
      .terminal-card :global(.terminal-mock){
        max-width:none;
        border:0;
        border-radius:0;
        box-shadow:none;
      }
      .cli-first .terminal-card{
        max-width:780px;
        margin:34px auto 0;
        text-align:left;
      }
      .panel-head{
        min-height:44px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:16px;
        padding:12px 15px;
        border-bottom:1px solid var(--line);
        color:var(--quiet);
        font-family:ui-monospace,"SF Mono",Consolas,monospace;
        font-size:12px;
        letter-spacing:.08em;
        text-transform:uppercase;
      }
      .terminal-lines{
        margin:0;
        padding:18px;
        color:var(--text);
        font-family:ui-monospace,"SF Mono",Consolas,monospace;
        font-size:14px;
        line-height:1.65;
        white-space:pre-wrap;
      }
      .ok{color:var(--ok)}
      .dim{color:var(--quiet)}
      section{
        scroll-margin-top:88px;
        padding:72px 0;
        border-top:1px solid var(--line-2);
      }
      .boxed-product section{padding-left:48px;padding-right:48px}
      .section-grid{
        display:grid;
        grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr);
        gap:44px;
        align-items:start;
      }
      .cli-first .section-grid,.docs-hybrid .section-grid{
        grid-template-columns:1fr;
        max-width:880px;
      }
      h2{
        max-width:740px;
        margin:0 0 14px;
        font-size:clamp(32px,4vw,52px);
        line-height:1.06;
        letter-spacing:0;
      }
      .lead{
        max-width:700px;
        margin:0;
        color:var(--muted);
        font-size:17px;
      }
      .diagram{
        display:grid;
        grid-template-columns:minmax(130px,.7fr) minmax(0,1fr) minmax(140px,.75fr);
        gap:16px;
        padding:18px;
      }
      .v9-less-diagram .diagram{
        grid-template-columns:1fr 1fr 1fr;
        padding:16px;
      }
      .diagram-group{
        border:1px solid #31445f;
        border-radius:8px;
        background:#0a1728;
        padding:14px;
      }
      .diagram-title{
        margin:0 0 10px;
        color:var(--accent);
        font-family:ui-monospace,"SF Mono",Consolas,monospace;
        font-size:11px;
        letter-spacing:.1em;
        text-transform:uppercase;
      }
      .diagram ul{
        display:grid;
        gap:7px;
        margin:0;
        padding:0;
        color:var(--text);
        list-style:none;
        font-size:13px;
      }
      .tool-node{
        border:1px solid var(--line);
        border-radius:7px;
        padding:10px;
        background:#07111f;
        color:var(--text);
        font-family:ui-monospace,"SF Mono",Consolas,monospace;
        font-size:12px;
      }
      .feature-grid{
        display:grid;
        grid-template-columns:repeat(4,minmax(0,1fr));
        border-top:1px solid var(--line);
        border-left:1px solid var(--line);
      }
      .feature{
        min-width:0;
        padding:20px;
        border-right:1px solid var(--line);
        border-bottom:1px solid var(--line);
        background:rgba(13,27,46,.54);
      }
      .feature span{
        display:block;
        margin-bottom:14px;
        color:var(--accent);
        font-family:ui-monospace,"SF Mono",Consolas,monospace;
        font-size:11px;
        letter-spacing:.12em;
        text-transform:uppercase;
      }
      .feature h3{margin:0 0 8px;font-size:18px}
      .feature p{margin:0;color:var(--muted);font-size:14px}
      .proof-columns{
        display:grid;
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:16px;
      }
      .blueprint-card{
        min-width:0;
        border:1px solid var(--line);
        border-radius:10px;
        background:
          linear-gradient(rgba(255,255,255,.026) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,.026) 1px, transparent 1px),
          rgba(13,27,46,.86);
        background-size:18px 18px,18px 18px,auto;
        overflow:hidden;
      }
      .blueprint-map{
        position:relative;
        display:grid;
        grid-template-columns:repeat(3,minmax(0,1fr));
        gap:16px;
        padding:18px;
      }
      .blueprint-map::before,
      .blueprint-map::after{
        content:"";
        position:absolute;
        top:50%;
        width:34px;
        height:1px;
        background:var(--accent);
        opacity:.78;
      }
      .blueprint-map::before{
        left:calc(33.333% - 17px);
      }
      .blueprint-map::after{
        left:calc(66.666% - 17px);
      }
      .blueprint-node{
        min-width:0;
        min-height:178px;
        display:flex;
        flex-direction:column;
        justify-content:space-between;
        border:1px solid #31445f;
        border-radius:8px;
        padding:15px;
        background:rgba(7,17,31,.82);
      }
      .blueprint-node em{
        color:var(--accent);
        font-family:ui-monospace,"SF Mono",Consolas,monospace;
        font-size:11px;
        font-style:normal;
        letter-spacing:.12em;
        text-transform:uppercase;
      }
      .blueprint-node strong{
        display:block;
        margin:18px 0 8px;
        color:var(--ink);
        font-size:20px;
        line-height:1.12;
      }
      .blueprint-node p{
        margin:0;
        color:var(--muted);
        font-size:13px;
      }
      .blueprint-note{
        margin:0;
        padding:0 18px 18px;
        color:var(--muted);
        font-size:13px;
      }
      .proof-card{padding:22px}
      .proof-card ul{
        display:grid;
        gap:10px;
        margin:16px 0 0;
        padding:0;
        list-style:none;
        color:var(--text);
        font-family:ui-monospace,"SF Mono",Consolas,monospace;
        font-size:13px;
      }
      .ide-wrap{
        width:min(860px,100%);
        margin:26px auto 0;
      }
      .two-column-proof .ide-wrap{width:min(760px,100%)}
      .docs-hybrid .ide-wrap{display:none}
      .ide-wrap :global(.ide-mock){--ide-mock-height:360px}
      .two-column-proof .ide-wrap :global(.ide-mock){--ide-mock-height:330px}
      .setup-grid{
        display:grid;
        grid-template-columns:minmax(0,1fr) minmax(340px,.75fr);
        gap:24px;
        align-items:start;
      }
      .docs-hybrid .setup-grid,.cli-first .setup-grid{grid-template-columns:1fr}
      .commands{display:grid;gap:12px}
      .command-item{
        display:grid;
        gap:8px;
        border:1px solid var(--line);
        border-radius:10px;
        background:#07101d;
        padding:15px;
      }
      .command-item code{
        color:var(--accent-2);
        font-family:ui-monospace,"SF Mono",Consolas,monospace;
        overflow-wrap:anywhere;
      }
      .command-item p{margin:0;color:var(--muted);font-size:14px}
      .faq-list{
        display:grid;
        gap:10px;
      }
      details{
        border:1px solid var(--line);
        border-radius:8px;
        background:rgba(13,27,46,.62);
        overflow:hidden;
      }
      summary{
        min-height:52px;
        display:flex;
        align-items:center;
        gap:12px;
        padding:14px 16px;
        color:var(--ink);
        cursor:pointer;
        font-weight:750;
        list-style:none;
      }
      summary::-webkit-details-marker{display:none}
      summary::before{
        content:"+";
        color:var(--accent);
        font-family:ui-monospace,"SF Mono",Consolas,monospace;
        flex:0 0 16px;
      }
      details[open] summary::before{content:"-"}
      details p{margin:0;padding:0 16px 18px 44px;color:var(--muted)}
      .concept-strip{
        padding:18px 0;
        border-top:1px solid var(--line);
        color:var(--muted);
        font-size:13px;
      }
      .concept-strip .wrap{
        display:flex;
        justify-content:space-between;
        gap:16px;
        flex-wrap:wrap;
      }
      .concept-strip a{color:var(--text);text-decoration:none}
      .concept-strip a:hover{color:var(--ink)}
      @media(max-width:980px){
        .hero-shell,.section-grid,.setup-grid,.proof-columns{
          grid-template-columns:1fr;
        }
        .hero-shell{min-height:0;padding:58px 0}
        .boxed-product .hero-shell{
          grid-template-columns:1fr;
          padding:46px 26px;
        }
        .boxed-product section{padding-left:26px;padding-right:26px}
        .diagram,.v9-less-diagram .diagram,.blueprint-map{grid-template-columns:1fr}
        .blueprint-map::before,.blueprint-map::after{display:none}
        .blueprint-node{min-height:138px}
        .feature-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
        .hero-visual{order:-1}
        .cli-first .hero-visual,.docs-hybrid .hero-visual{order:0}
      }
      @media(max-width:640px){
        body{padding-top:92px}
        .wrap,.boxed-product .topbar,.page-frame{width:calc(100vw - 32px)}
        .nav{align-items:flex-start;min-height:auto;padding:14px 0}
        .navlinks{justify-content:flex-end;gap:12px;flex-wrap:wrap}
        .navlinks a{font-size:12px}
        h1{font-size:42px;max-width:12ch}
        .boxed-product h1{font-size:40px}
        .cli-first h1,.docs-hybrid h1{max-width:none}
        section{padding:50px 0}
        .feature-grid{grid-template-columns:1fr}
        .boxed-product section{padding-left:18px;padding-right:18px}
        .ide-wrap :global(.ide-mock){--ide-mock-height:360px}
      }
    </style>
  </head>
  <body class={concept.slug}>
    <header class="topbar">
      <nav class="wrap nav" aria-label="Primary">
        <a class="brand" href="/concepts/"><span>xt</span>ctx</a>
        <div class="navlinks">
          {conceptNav.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </nav>
    </header>

    <main class="page-frame">
      <section class="hero-shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="kicker">{concept.shortName} concept</p>
          <h1 id="hero-title">{concept.headline}</h1>
          <p>{concept.subhead}</p>
          <ul class="proof-list" aria-label="Product constraints">
            <li>Setup writes local config</li>
            <li>Raw transcripts stay local</li>
            <li>Five MCP tools</li>
          </ul>
          <div class="command-pill"><span class="prompt">$</span><span>npx -y xtctx setup</span></div>
          <div class="actions">
            <a class="button" href="#setup">Get started</a>
            <a class="button secondary" href="https://github.com/fstubner/xtctx">View source</a>
          </div>
        </div>
        <div class="hero-visual">
          {concept.slug === 'boxed-product' ? (
            <div class="setup-terminal" aria-label="Setup terminal preview">
              <div class="setup-terminal-head">
                <div class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></div>
                <span>bash</span>
                <span></span>
              </div>
              <div class="setup-terminal-body">
                <p class="term-command"><span class="prompt">$</span> npx -y xtctx setup</p>
                <p class="term-line"><strong>xtctx setup</strong> for ~/projects/my-app</p>
                <p class="term-note">Detected Claude Code, Codex, Cursor, and Antigravity.</p>
                <p class="term-question">Select skills to sync</p>
                <p class="term-choice"><span>[x]</span><strong>xtctx-handoff</strong><em>required</em></p>
                <p class="term-choice"><span>[x]</span><strong>review-notes</strong><em>Claude Code</em></p>
                <p class="term-choice"><span>[x]</span><strong>release-checks</strong><em>.xtctx/skills</em></p>
                <p class="term-choice"><span>[ ]</span><strong>scratchpad</strong><em>skip</em></p>
                <p class="term-question">Apply these changes? Yes</p>
                <div class="term-rule"></div>
                <p class="term-success"><span class="ok">ok</span>.xtctx/config.yaml</p>
                <p class="term-success"><span class="ok">ok</span>managed instructions written</p>
                <p class="term-success"><span class="ok">ok</span>MCP server registered</p>
                <p class="term-done">Ready for the next coding agent.</p>
              </div>
            </div>
          ) : concept.slug === 'cli-first' || concept.slug === 'docs-hybrid' ? (
            <div class="terminal-card"><TerminalMock /></div>
          ) : (
            <div class="terminal-card">
              <div class="panel-head"><span>setup command</span><span>run from project root</span></div>
              <pre class="terminal-lines" set:html={setupOutputHtml}></pre>
            </div>
          )}
        </div>
      </section>

      <section id="how">
        <div class="section-grid">
          <div>
            <p class="section-label">How it works</p>
            <h2>
              {concept.slug === 'cli-first'
                ? 'Run a command. MCP reads the local index.'
                : concept.slug === 'docs-hybrid'
                  ? 'Setup writes files. Clients call MCP.'
                  : 'Setup writes config. Tools call MCP.'}
            </h2>
            <p class="lead">{concept.approach}</p>
          </div>
          <div class={concept.slug === 'two-column-proof' ? 'proof-columns' : concept.slug === 'boxed-product' ? 'blueprint-card' : 'diagram-card'}>
            {concept.slug === 'boxed-product' ? (
              <>
                <div class="panel-head"><span>handoff blueprint</span><span>no background service</span></div>
                <div class="blueprint-map">
                  {blueprintNodes.map((node) => (
                    <article class="blueprint-node">
                      <em>{node.label}</em>
                      <div>
                        <strong>{node.title}</strong>
                        <p>{node.body}</p>
                      </div>
                    </article>
                  ))}
                </div>
                <p class="blueprint-note">
                  Raw transcript files stay authoritative. The SQLite index is rebuildable and updated on MCP retrieval.
                </p>
              </>
            ) : concept.slug === 'two-column-proof' ? (
              <>
                <article class="proof-card">
                  <p class="section-label">What setup writes</p>
                  <h3>Project files</h3>
                  <ul>
                    <li>.xtctx/config.yaml</li>
                    <li>AGENTS.md managed block</li>
                    <li>.codex/config.toml</li>
                    <li>.xtctx/skills</li>
                  </ul>
                </article>
                <article class="proof-card">
                  <p class="section-label">What agents call</p>
                  <h3>MCP tools</h3>
                  <ul>
                    <li>xtctx_recent_sessions</li>
                    <li>xtctx_session_detail</li>
                    <li>xtctx_search_sessions</li>
                    <li>xtctx_continuity_status</li>
                  </ul>
                </article>
              </>
            ) : (
              <>
                <div class="panel-head"><span>MCP tools</span><span>No generated summary required</span></div>
                <div class="diagram">
                  <div class="diagram-group">
                    <p class="diagram-title">Tool transcripts</p>
                    <ul>
                      <li>Codex sessions</li>
                      <li>Claude Code projects</li>
                      <li>Antigravity conversations</li>
                      <li>Antigravity conversations</li>
                    </ul>
                  </div>
                  <div class="diagram-group">
                    <p class="diagram-title">MCP</p>
                    <div class="tool-node">xtctx_recent_sessions</div>
                    <div class="tool-node">xtctx_session_detail</div>
                    <div class="tool-node">xtctx_search_sessions</div>
                    <div class="tool-node">xtctx_continuity_status</div>
                  </div>
                  <div class="diagram-group">
                    <p class="diagram-title">Client result</p>
                    <ul>
                      <li>Find recent work</li>
                      <li>Open raw messages</li>
                      <li>Search ordered windows</li>
                      <li>Check wiring status</li>
                    </ul>
                  </div>
                </div>
              </>
            )}
          </div>
        </div>
        {concept.slug !== 'cli-first' && (
          <div class="ide-wrap"><IdeMock /></div>
        )}
      </section>

      <section id="features">
        <p class="section-label">Features</p>
        <h2>
          {concept.slug === 'docs-hybrid'
            ? 'The complete product surface'
            : 'Config, instructions, skills, and cache'}
        </h2>
        <p class="lead">
          xtctx does not run a web app, API server, daemon, or durable memory
          layer. It writes local files and serves MCP retrieval on demand.
        </p>
        <div class="feature-grid" aria-label="Feature list">
          {conceptFeatures.map((feature) => (
            <article class="feature">
              <span>{feature.label}</span>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="setup">
        <div class="setup-grid">
          <div>
            <p class="section-label">Setup</p>
            <h2>Install, then check</h2>
            <p class="lead">
              The plugin gets you the MCP tools without touching the repo. Setup
              writes the generated files this page describes. Status reports
              configured tools, transcript freshness, selected skills, and
              unsupported targets.
            </p>
          </div>
          <div class="commands">
            <article class="command-item">
              <strong>Install the plugin</strong>
              <code>claude plugin install xtctx@xtctx</code>
              <p>
                Registers the MCP server and handoff skill, writes nothing into the
                repo. Retrieval works without any of the files below. Add the
                marketplace first; see the README for other tools.
              </p>
            </article>
            <article class="command-item">
              <strong>Add project wiring</strong>
              <code>npx -y xtctx setup</code>
              <p>Detect tools, choose skills, write MCP config, and repair managed blocks.</p>
            </article>
            <article class="command-item">
              <strong>Check configured surfaces</strong>
              <code>npx -y xtctx status</code>
              <p>Inspect wiring, transcript freshness, skill drift, and unsupported targets.</p>
            </article>
            <article class="command-item">
              <strong>Remove one tool</strong>
              <code>npx -y xtctx disconnect antigravity</code>
              <p>Remove generated xtctx management without deleting transcripts.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="faqs">
        <div class="section-grid">
          <div>
            <p class="section-label">FAQs</p>
            <h2>Questions before using it in a repo</h2>
            <p class="lead">Short answers about storage, setup, and limits.</p>
          </div>
          <div class="faq-list">
            <details>
              <summary>Does xtctx run in the background?</summary>
              <p>No. MCP retrieval updates the local cache on demand.</p>
            </details>
            <details>
              <summary>Does it summarize sessions?</summary>
              <p>No. Raw transcript messages remain the source of truth.</p>
            </details>
            <details>
              <summary>Can I test it without private transcripts?</summary>
              <p>Yes. The public demo uses synthetic Claude Code and Codex transcript stores.</p>
            </details>
          </div>
        </div>
      </section>
    </main>

    <div class="concept-strip">
      <div class="wrap">
        <span>Concept {currentIndex + 1} of {concepts.length}: {concept.name}</span>
        <span>
          {concepts.map((item, index) => (
            <>
              <a href={`/concepts/${item.slug}/`}>{index + 1}</a>
              {index < concepts.length - 1 && ' / '}
            </>
          ))}
        </span>
      </div>
    </div>
  </body>
</html>
